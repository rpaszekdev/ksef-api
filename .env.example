# App
ENV=dev
DEBUG=true
APP_NAME=ksef-api
BASE_URL=http://localhost:8000

# Security
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-to-a-generated-fernet-key
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-hex-chars
JWT_ALG=HS256
JWT_TTL_MIN=60

# Database
DATABASE_URL=postgresql+asyncpg://ksef:ksef@localhost:5432/ksef

# Redis
REDIS_URL=redis://localhost:6379/0

# KSeF
KSEF_ENV=test   # test | demo | prod
# URLs derived automatically from KSEF_ENV

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOLO=price_...
STRIPE_PRICE_BIURO=price_...
STRIPE_PRICE_BIURO_PRO=price_...

# Observability
SENTRY_DSN=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
